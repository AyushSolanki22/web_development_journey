<%- include('../partials/head') %>
  </head>

  <body class="bg-gray-100">
    
    <%- include('../partials/header') %>

    <div class="max-w-xl mx-auto mt-12">
      <div class="bg-white shadow-lg rounded-md p-8">
        <h1 class="text-3xl font-bold text-center mb-8">
           <%=editing ? "Edit": "Register" %>  Your Home on AirBnB
        </h1>

        <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST">
          <input type="hidden" name="id" value="<%= editing? home._id : '' %>" >
          <input
            class="border w-full p-3 rounded mb-4"
            type="text"
             name="houseName"
            placeholder="Enter your Home Name"
            value="<%= editing ? home.name : '' %>"
          />
          <input
            class="border w-full p-3 rounded mb-4"
            type="text"
            name="housePrice"
            placeholder="Enter Home Price per night"
            value="<%= editing ? home.price : '' %>"
            
          />
          <input
            class="border w-full p-3 rounded mb-4"
            type="text"
            name="houseLocation"
            placeholder="Enter your Home Location"
            value="<%= editing ? home.location : '' %>"
          />
          <input
            class="border w-full p-3 rounded mb-4"
            type="text"
            name="houseRating"
            placeholder="Enter Home Rating"
            value="<%= editing ? home.rating : '' %>""
          />
          <input
            class="border w-full p-3 rounded mb-4"
            type="text"
            name="photoUrl"
            placeholder="Enter Photo Url"\
            value="<%= editing ? home.imageUrl : '' %>""
          />
          <textarea
            class="border w-full p-3 rounded mb-4"
            placeholder="Describe your home"
            name="description"><%= editing ? home.description : '' %></textarea>

          <button
            class="w-full bg-red-500 hover:bg-red-600 text-white py-3 rounded font-semibold"
          >
            <%= editing? "Update Home":"Add Home"  %>
          </button>
        </form>
      </div>
    </div>
  </body>
</html>

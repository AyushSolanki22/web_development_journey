<%- include("partials/head") %>
</head>

<body>

  <%- include("partials/header") %>

  <main
    class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl"
  >

    <h2
      class="text-3xl text-red-500 font-bold text-center mb-6"
    >
      Here are our registered homes: 
    </h2>

    <ul>
      <% if (registeredHomes.length === 0) { %>

        <li class="text-center text-gray-600">
          No homes registered yet.
        </li>

      <% } %>

      <% registeredHomes.forEach(home => { %>

        <li
          class="border rounded p-3 my-3 shadow-sm hover:shadow-md transition"
        >
          <%= home.houseName %>
        </li>

      <% }) %>                  

    </ul>

  </main>

</body>
</html>